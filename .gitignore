# Credentials never belong in this repo - it is meant to be public.
.env
.env.*
# ...but the TEMPLATE has to ship, or nobody knows what to put in .env. The
# pattern above matches it, so this exception is load-bearing: without it the
# file exists on disk, looks committed, and is missing for everyone who clones.
!.env.example
*.token
*token*.txt
*.pem
*.key
!*.ps1
!*.sh
!*.py

# Firmware build output. Releases are published as GitHub release assets, never committed.
# (firmware/ carries upstream's own .gitignore for its tree as well.)
build/
*.bin
sdkconfig.old

# Your own build settings - above all your server's address. Never public.
sdkconfig.defaults.local

# Factory backups and NVS dumps contain Wi-Fi credentials. Keep them off this disk entirely.
*backup*.bin
*nvs*.bin

# Local server state
server/data/
server/.env

# Personal tooling
.claude/settings.local.json
.vscode/
__pycache__/

# The dependency checker writes a log beside itself. Useful to paste into an
# issue, not something to commit.
deploy/check-deps.log
deploy/check-deps-error.txt
screens/

# 🔴 Vision bench descriptions are of somebody's room. Metrics are publishable;
#    what the camera saw is not.
tools/model-bench/results/**/*.local.txt
